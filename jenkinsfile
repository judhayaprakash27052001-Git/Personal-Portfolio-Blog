@Library('shared-lib') _

pipeline {
    agent any

    environment {
        IMAGE_NAME   = "udhaya2705/portfolio-app"
        IMAGE_TAG    = "${GIT_COMMIT.take(7)}"
        DOCKER_CREDS = "docker-creds"
    }

    stages {
        stage('Build') {
            steps {
                dockerBuild(
                    image: IMAGE_NAME,
                    tag: IMAGE_TAG,
                    dockerCreds: DOCKER_CREDS
                )
            }
        }

        stage('Test') {
            steps {
                dockerTest(
                    image: IMAGE_NAME,
                    tag: IMAGE_TAG,
                    container: "portfolio-test",
                    port: "8085"
                )
            }
        }

        stage('Deploy') {
            steps {
                dockerDeploy(
                    image: IMAGE_NAME,
                    tag: IMAGE_TAG,
                    container: "portfolio-app-prod",
                    port: "8080",
                    dockerCreds: DOCKER_CREDS
                )
            }
        }
    }
}
