@Library('shared-lib') _

pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                buildImage()
            }
        }

        stage('Test') {
            steps {
                testImage()
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                deployImage()
            }
        }
    }
}
